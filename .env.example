# monday.com (server-only)
MONDAY_API_TOKEN=
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=
MONDAY_API_VERSION=2026-07

# Optional LLM query planner (server-only)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

# Runtime behavior
# auto = live when all Monday variables exist, otherwise visibly labelled demo mode
# live = fail fast when Monday configuration is missing
# demo = always use deterministic synthetic records
DATA_MODE=auto
CACHE_TTL_SECONDS=120
